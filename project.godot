; Crisp Juice Free - demo project. Open this folder in Godot 4.3 or newer and press F5,
; or copy addons/crisp_juice_free into your own project.
config_version=5

[application]

config/name="Crisp Juice Free"
run/main_scene="res://addons/crisp_juice_free/demo/vfx_demo.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.png"

[display]

window/size/viewport_width=960
window/size/viewport_height=600
